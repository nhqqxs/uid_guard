 /*
+ * Android app 域的 uid 存在性过滤。
+ *
+ * getpriority()/setpriority() 的 PRIO_USER 与 ioprio_get()/ioprio_set() 的
+ * IOPRIO_WHO_USER 都会经过 find_user()，因此在这里做一次判定即可覆盖这四个
+ * 系统调用：当调用者属于 app 侧（uid >= 10000，含 isolated 的 90000+）且目标
+ * uid 落在注入名单里时返回 NULL，系统调用自然得到 -ESRCH —— 与“该 uid 没有
+ * 可见的运行中进程”完全一致，不会产生额外的可区分性。
+ *
+ * 名单存的是 base uid（user 0 的 app uid）。Android 上同一个包在所有用户和
+ * 工作资料里共享同一个 base uid（uid = base + userId * 100000），所以判定时
+ * 先把 uid 归一化到 base uid，天然覆盖所有用户的副本。
+ *
+ * 名单由 userspace 通过 uid_guard_set() 注入，默认空 => 功能不生效。
+ */
+#define UID_GUARD_MAX		128
+#define UID_GUARD_USER_OFFSET	100000
+#define UID_GUARD_APP_MIN	10000
+
+struct uid_guard_table {
+	u32 count;
+	u32 uids[UID_GUARD_MAX];
+};
+
+static struct uid_guard_table uid_guard_tbl[2];
+static struct uid_guard_table *uid_guard_cur;
+static DEFINE_SPINLOCK(uid_guard_lock);
+
+static inline u32 uid_guard_aid(kuid_t uid)
+{
+	return uid.val % UID_GUARD_USER_OFFSET;
+}
+
+static bool uid_guard_listed(const struct uid_guard_table *tbl, u32 aid)
+{
+	u32 i;
+
+	for (i = 0; i < tbl->count; i++) {
+		if (tbl->uids[i] == aid)
+			return true;
+	}
+
+	return false;
+}
+
+static bool uid_guard_masked(kuid_t uid)
+{
+	struct uid_guard_table *tbl;
+	kuid_t caller = current_uid();
+
+	/* app 查自己（含同进程其它线程）永远放行 */
+	if (uid_eq(uid, caller))
+		return false;
+
+	/* 只有 app 侧的调用者需要被过滤：系统 / root / 内核线程一律放行 */
+	if (uid_guard_aid(caller) < UID_GUARD_APP_MIN)
+		return false;
+
+	tbl = smp_load_acquire(&uid_guard_cur);
+	if (!tbl || !tbl->count)
+		return false;
+
+	return uid_guard_listed(tbl, uid_guard_aid(uid));
+}
+
+/**
+ * uid_guard_set - 注入需要屏蔽的 base uid 名单
+ * @uids: base uid 数组
+ * @count: 数组长度，最多 UID_GUARD_MAX 个
+ *
+ * 允许重复调用，后一次覆盖前一次。返回 0 成功，-EINVAL 参数非法。
+ *
+ * 双缓冲 + 指针替换实现无锁读取：写入方在 spinlock 下填好另一个缓冲区，
+ * 再用 smp_store_release 切换，读取方只会看到完整填好的表。
+ */
+int uid_guard_set(const u32 *uids, u32 count)
+{
+	struct uid_guard_table *tbl;
+	unsigned long flags;
+	u32 i;
+
+	if (!uids || !count || count > UID_GUARD_MAX)
+		return -EINVAL;
+
+	spin_lock_irqsave(&uid_guard_lock, flags);
+
+	tbl = (uid_guard_cur == &uid_guard_tbl[0]) ? &uid_guard_tbl[1]
+						  : &uid_guard_tbl[0];
+	tbl->count = 0;
+
+	for (i = 0; i < count; i++) {
+		u32 aid = uids[i] % UID_GUARD_USER_OFFSET;
+
+		if (aid < UID_GUARD_APP_MIN)
+			continue;
+		if (tbl->count >= UID_GUARD_MAX)
+			break;
+		if (uid_guard_listed(tbl, aid))
+			continue;
+
+		tbl->uids[tbl->count++] = aid;
+	}
+
+	smp_store_release(&uid_guard_cur, tbl);
+	spin_unlock_irqrestore(&uid_guard_lock, flags);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(uid_guard_set);
+
